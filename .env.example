# Configuration reference: Django does not automatically read this file.
# Set these variables in your shell or hosting service before starting Django.
# Local development works without setting any of them.

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# In development Django generates a local secret in backend/.dev-secret-key.
# For production, supply a unique secret and set DJANGO_DEBUG=false.
# DJANGO_SECRET_KEY=replace-with-a-long-random-private-value
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-pharmacy.example
# DJANGO_DATABASE_PATH=/absolute/path/to/pharmacy.sqlite3
# DJANGO_SECURE_SSL_REDIRECT=true

# Multiple workers need a shared cache for login failure counts.
# Example: Django's built-in database cache (run manage.py createcachetable once).
# DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# DJANGO_CACHE_LOCATION=pharmacy_auth_cache
